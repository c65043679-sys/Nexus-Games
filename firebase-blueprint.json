{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile data including display name and avatar",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email"]
    },
    "GameSave": {
      "title": "Game Save",
      "description": "Saved game data for a specific user and game",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "gameId": { "type": "string" },
        "data": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "gameId", "data"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "Collection of user profiles"
    },
    "/users/{uid}/saves/{gameId}": {
      "schema": "GameSave",
      "description": "Subcollection for user specific game saves"
    }
  }
}
